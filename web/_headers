# Netlify and Cloudflare Pages both read this file.
#
# The content security policy is tight because the site genuinely has no third-party
# dependencies: everything it loads comes from its own origin. 'unsafe-inline' is needed
# because the page's script and styles are inline in index.html; blob: is needed because
# MapLibre runs its renderer in a worker it creates from a blob.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()

# The data files change every rebuild, so they must not be cached hard.
/*.json
  Cache-Control: public, max-age=300, must-revalidate

# The library and the font never change without changing name.
/maplibre-gl.js
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
